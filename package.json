{
  "author": "Dijital Kurdistan Tech Institute <info@pezkuwichain.io>",
  "bugs": "https://git.pezkuwichain.io/pezkuwichain/pezkuwi-apps/issues",
  "description": "An Apps portal into the Pezkuwi network",
  "engines": {
    "node": ">=18.14"
  },
  "homepage": "https://git.pezkuwichain.io/pezkuwichain/pezkuwi-apps#readme",
  "license": "Apache-2.0",
  "name": "pezkuwi-apps",
  "packageManager": "yarn@4.6.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://git.pezkuwichain.io/pezkuwichain/pezkuwi-apps.git"
  },
  "sideEffects": false,
  "type": "module",
  "version": "1.0.2-1-x",
  "versions": {
    "git": "1.0.2-1-x",
    "npm": "1.0.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "analyze": "yarn clean && BUILD_ANALYZE=1 yarn run build:code && yarn source-map-explorer packages/apps/build/app.*.js",
    "build": "yarn run build:i18n && yarn run build:code",
    "build:before": "yarn build:images && yarn build:typesBundle",
    "build:code": "NODE_ENV=production yarn pezkuwi-dev-build-ts",
    "build:i18n": "i18next-scanner --config i18next-scanner.config.cjs && node ./scripts/i18nSort.cjs",
    "build:images": "node scripts/imgConvert.mjs",
    "build:robohash": "node scripts/robohash.cjs",
    "build:typesBundle": "pezkuwi-dev-run-test --env node --loader extensionless typesBundle",
    "build:www": "rm -rf packages/apps/build && mkdir -p packages/apps/build && yarn run build:i18n && cd packages/apps && yarn pezkuwi-exec-webpack --config webpack.config.cjs",
    "ci:chainEndpoints": "pezkuwi-dev-run-test --env node --logfile .github/chain-endpoints.md packages/apps-config/src/ci/chainEndpoints",
    "ci:chainTypes": "echo ok",
    "clean": "pezkuwi-dev-clean-build",
    "clean:i18n": "rm -rf packages/apps/public/locales/en && mkdir -p packages/apps/public/locales/en",
    "docs": "echo \"skipping docs\"",
    "lint": "pezkuwi-dev-run-lint",
    "postinstall": "pezkuwi-dev-yarn-only",
    "start": "yarn clean && cd packages/apps && yarn pezkuwi-exec-webpack serve --config webpack.serve.cjs --port 3000",
    "test": "pezkuwi-dev-run-test --env browser ^typesBundle ^chainEndpoints ^chainTypes ^page- ^react-",
    "test:all": "pezkuwi-dev-run-test --env browser ^chainEndpoints ^chainTypes",
    "test:one": "pezkuwi-dev-run-test --env browser",
    "test:skipped": "echo 'tests skipped'"
  },
  "devDependencies": {
    "@pezkuwi/dev": "^0.86.4",
    "@pezkuwi/extension-dapp": "^0.62.27",
    "@pezkuwi/extension-inject": "^0.62.27",
    "@types/chart.js": "^2.9.41",
    "@types/file-saver": "^2.0.7",
    "@types/react-beautiful-dnd": "^13.1.7",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "^18.2.18",
    "@types/react-router-dom": "^5.3.3",
    "@types/store": "^2.0.5",
    "dnslink-cloudflare": "^3.0.0",
    "extensionless": "^1.9.6",
    "i18next-scanner": "^4.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-is": "^18.2.0",
    "source-map-explorer": "^2.5.3"
  },
  "resolutions": {
    "@pezkuwi/api": "^16.5.37",
    "@pezkuwi/api-augment": "^16.5.37",
    "@pezkuwi/api-base": "^16.5.37",
    "@pezkuwi/api-contract": "^16.5.37",
    "@pezkuwi/api-derive": "^16.5.37",
    "@pezkuwi/extension-dapp": "0.62.27",
    "@pezkuwi/extension-inject": "0.62.27",
    "@pezkuwi/hw-ledger": "^14.0.26",
    "@pezkuwi/keyring": "^14.0.26",
    "@pezkuwi/networks": "^14.0.26",
    "@pezkuwi/phishing": "^0.25.28",
    "@pezkuwi/react-identicon": "^3.17.3",
    "@pezkuwi/react-qr": "^3.17.3",
    "@pezkuwi/rpc-augment": "^16.5.37",
    "@pezkuwi/rpc-core": "^16.5.37",
    "@pezkuwi/rpc-provider": "^16.5.37",
    "@pezkuwi/typegen": "^16.5.37",
    "@pezkuwi/types": "^16.5.37",
    "@pezkuwi/types-augment": "^16.5.37",
    "@pezkuwi/types-codec": "^16.5.37",
    "@pezkuwi/types-create": "^16.5.37",
    "@pezkuwi/types-known": "^16.5.37",
    "@pezkuwi/types-support": "^16.5.37",
    "@pezkuwi/ui-keyring": "^3.17.3",
    "@pezkuwi/ui-settings": "^3.17.3",
    "@pezkuwi/ui-shared": "^3.17.3",
    "@pezkuwi/util": "^14.0.26",
    "@pezkuwi/util-crypto": "^14.0.26",
    "@pezkuwi/wasm-crypto": "^7.5.20",
    "@pezkuwi/x-bigint": "^14.0.26",
    "@pezkuwi/x-fetch": "^14.0.26",
    "@pezkuwi/x-global": "^14.0.26",
    "@pezkuwi/x-randomvalues": "^14.0.26",
    "@pezkuwi/x-textdecoder": "^14.0.26",
    "@pezkuwi/x-textencoder": "^14.0.26",
    "@pezkuwi/x-ws": "^14.0.26",
    "@zondax/ledger-substrate": "1.1.1",
    "braces": "npm:@pezkuwi/braces@^3.0.4",
    "typescript": "5.5.4"
  }
}
