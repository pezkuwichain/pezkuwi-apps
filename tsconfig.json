{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "./packages",
    "composite": false,
    /*
     * Disabled since some of our packaged dependencies are problematic
     *
     * (also disabled in tsconfig.build.json)
     */
    "verbatimModuleSyntax": false
  },
  "include": [
    "packages/**/src/**/*",
    "scripts/*"
  ],
  "exclude": [
    "**/node_modules/**/*"
  ]
}
